FROM jenkins/jenkins:lts-jdk17

USER root

# Install tools: Node.js, npm, curl, git, and Docker CLI + Docker Compose
RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs \
    npm \
    curl \
    git \
 && curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-27.3.1.tgz -o /tmp/docker.tgz \
 && tar -xzf /tmp/docker.tgz -C /tmp \
 && cp /tmp/docker/docker /usr/bin/docker \
 && chmod +x /usr/bin/docker \
 && rm -rf /tmp/docker* /var/lib/apt/lists/*

RUN curl -SL https://github.com/docker/compose/releases/download/v2.29.2/docker-compose-linux-x86_64 -o /usr/local/bin/docker-compose \
 && chmod +x /usr/local/bin/docker-compose \
 && ln -sf /usr/local/bin/docker-compose /usr/bin/docker-compose \
 && mkdir -p /usr/local/lib/docker/cli-plugins /usr/lib/docker/cli-plugins /root/.docker/cli-plugins \
 && cp /usr/local/bin/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose \
 && cp /usr/local/bin/docker-compose /usr/lib/docker/cli-plugins/docker-compose \
 && cp /usr/local/bin/docker-compose /root/.docker/cli-plugins/docker-compose

# Pre-install Jenkins plugins for Pipeline, Git, and GitHub Webhooks
RUN jenkins-plugin-cli --plugins "workflow-aggregator git github"

# Copy initialization script
COPY init.groovy.d/ /usr/share/jenkins/ref/init.groovy.d/

USER root
